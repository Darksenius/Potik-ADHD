<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/notification_panel_card"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/panel_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/panel_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/notification_panel_position"
            android:gravity="center"
            android:maxLines="1"
            android:minHeight="24dp"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/panel_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/panel_navigation_row"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/panel_previous"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/notification_panel_tile"
            android:clickable="true"
            android:contentDescription="Попередня задача"
            android:focusable="true"
            android:padding="13dp"
            android:src="@drawable/notification_panel_previous" />

        <LinearLayout
            android:id="@+id/panel_complete"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/notification_panel_primary"
            android:clickable="true"
            android:contentDescription="Готово"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/panel_complete_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Готово"
                android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/panel_next"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/notification_panel_tile"
            android:clickable="true"
            android:contentDescription="Наступна задача"
            android:focusable="true"
            android:padding="13dp"
            android:src="@drawable/notification_panel_next" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panel_counter_row"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/panel_minus"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/notification_panel_tile"
            android:clickable="true"
            android:contentDescription="Зменшити лічильник"
            android:focusable="true"
            android:padding="14dp"
            android:src="@drawable/notification_panel_minus" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/panel_counter_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/panel_plus"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/notification_panel_tile"
            android:clickable="true"
            android:contentDescription="Збільшити лічильник"
            android:focusable="true"
            android:padding="14dp"
            android:src="@drawable/notification_panel_plus" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panel_defer_row"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/panel_not_now"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/notification_panel_tile"
            android:clickable="true"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center"
            android:maxLines="2"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="Не зараз"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/panel_not_today"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/notification_panel_tile"
            android:clickable="true"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center"
            android:maxLines="2"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="Не сьогодні"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
