<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/panel_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />

        <TextView
            android:id="@+id/panel_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Info" />
    </LinearLayout>

    <TextView
        android:id="@+id/panel_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Info" />

    <LinearLayout
        android:id="@+id/panel_navigation_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/panel_previous"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Попередня задача"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="‹"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />

        <TextView
            android:id="@+id/panel_minus"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Зменшити кількість"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="−"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
            android:visibility="gone" />

        <TextView
            android:id="@+id/panel_complete"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="88dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Виконано"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/panel_plus"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Збільшити кількість"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="+"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
            android:visibility="gone" />

        <TextView
            android:id="@+id/panel_next"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Наступна задача"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="›"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panel_defer_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/panel_not_now"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:maxLines="1"
            android:text="Не зараз"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Info" />

        <TextView
            android:id="@+id/panel_not_today"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:maxLines="1"
            android:text="Не сьогодні"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Info" />
    </LinearLayout>
</LinearLayout>
