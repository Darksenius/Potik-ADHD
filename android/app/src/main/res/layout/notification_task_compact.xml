<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/notification_panel_card"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <TextView
        android:id="@+id/panel_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/panel_position"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:background="@drawable/notification_panel_position"
        android:gravity="center"
        android:maxLines="1"
        android:minHeight="28dp"
        android:paddingStart="9dp"
        android:paddingEnd="9dp"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Keep the rendering contract for buildMain while reserving the compact height for title and position. -->
    <TextView
        android:id="@+id/panel_details"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</LinearLayout>
